{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },

    "configurePresets": [
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug (x64)",
            "description": "Visual Studio / MSVC — Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release (x64)",
            "description": "Visual Studio / MSVC — Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "mingw-debug",
            "displayName": "MinGW Debug (MSYS2)",
            "description": "MinGW-w64 GCC, Debug — MSYS2 terminalinden",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc"
            }
        }
    ],

    "buildPresets": [
        { "name": "msvc-debug",   "configurePreset": "msvc-debug"  },
        { "name": "msvc-release", "configurePreset": "msvc-release" },
        { "name": "mingw-debug",  "configurePreset": "mingw-debug"  }
    ]
}
