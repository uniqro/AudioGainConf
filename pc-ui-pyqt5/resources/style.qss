/* ═══════════════════════════════════════════════════════
   Audio DSP Configuration — Dark Theme
   ═══════════════════════════════════════════════════════ */

QWidget {
    background-color: #12121e;
    color: #dde3ee;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* ── Group Boxes ──────────────────────────────────────── */
QGroupBox {
    border: 1px solid #1e3a5c;
    border-radius: 5px;
    margin-top: 8px;
    padding-top: 10px;
    font-weight: bold;
    font-size: 12px;
    color: #4FC3F7;
    letter-spacing: 0.5px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #4FC3F7;
}

/* ── Buttons ──────────────────────────────────────────── */
QPushButton {
    background-color: #162033;
    border: 1px solid #2e5f8a;
    border-radius: 4px;
    padding: 6px 14px;
    color: #b0c4de;
    font-weight: bold;
    font-size: 12px;
    min-height: 26px;
}
QPushButton:hover {
    background-color: #1e3a5c;
    border-color: #4FC3F7;
    color: #4FC3F7;
}
QPushButton:pressed {
    background-color: #0f2540;
}
QPushButton:disabled {
    background-color: #181828;
    border-color: #252538;
    color: #333355;
}

QPushButton#connectBtn {
    background-color: #1b3d1f;
    border-color: #4CAF50;
    color: #4CAF50;
}
QPushButton#connectBtn:hover {
    background-color: #2e7d32;
    color: #ffffff;
}

QPushButton#disconnectBtn {
    background-color: #3d1b1b;
    border-color: #e53935;
    color: #ef9a9a;
}
QPushButton#disconnectBtn:hover {
    background-color: #c62828;
    color: #ffffff;
}

QPushButton#actionBtn {
    background-color: #162033;
    border-color: #4FC3F7;
    color: #4FC3F7;
    font-size: 12px;
    letter-spacing: 0.5px;
}
QPushButton#actionBtn:hover {
    background-color: #1565c0;
    color: #ffffff;
}
QPushButton#actionBtn:disabled {
    border-color: #1e3a4a;
    color: #2a4a5a;
}

QPushButton#applyBtn {
    background-color: #1b3d1f;
    border-color: #4CAF50;
    color: #4CAF50;
    font-size: 12px;
    letter-spacing: 0.5px;
}
QPushButton#applyBtn:hover {
    background-color: #2e7d32;
    color: #ffffff;
}
QPushButton#applyBtn:disabled {
    background-color: #1a2a1a;
    border-color: #254025;
    color: #2a4a2a;
}

QPushButton#applyAllBtn {
    background-color: #1e2d1e;
    border-color: #66BB6A;
    color: #66BB6A;
    font-size: 11px;
    letter-spacing: 0.3px;
}
QPushButton#applyAllBtn:hover {
    background-color: #2e7d32;
    color: #ffffff;
    border-color: #81C784;
}
QPushButton#applyAllBtn:disabled {
    background-color: #1a2a1a;
    border-color: #254025;
    color: #2a4a2a;
}

QPushButton#fileBtn {
    background-color: #14203a;
    border: 1px solid #1e3a5c;
    color: #7090b0;
    font-weight: normal;
    font-size: 12px;
}
QPushButton#fileBtn:hover {
    background-color: #1e3a5c;
    border-color: #4FC3F7;
    color: #4FC3F7;
}

/* ── Toggle Switch ────────────────────────────────────── */
QPushButton#toggleSwitch {
    border-radius: 12px;
    font-size: 11px;
    font-weight: bold;
    min-width: 100px;
    max-width: 100px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    background-color: #1a1a2e;
    border: 1px solid #333355;
    color: #555577;
}
QPushButton#toggleSwitch:checked {
    background-color: #1b3d1f;
    border-color: #4CAF50;
    color: #6fcf6f;
    font-weight: bold;
}
QPushButton#toggleSwitch:hover {
    border-color: #4FC3F7;
}
QPushButton#toggleSwitch:checked:hover {
    background-color: #2e7d32;
    color: #ffffff;
}

/* ── Tab Bar (Mode Selector) ──────────────────────────── */
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background-color: #0e1828;
    border: 1px solid #1a3050;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 5px 20px;
    color: #445566;
    font-weight: bold;
    font-size: 12px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #1e3a5c;
    border-color: #4FC3F7;
    border-bottom: 2px solid #1e3a5c;
    color: #4FC3F7;
}
QTabBar::tab:hover:!selected {
    background-color: #162033;
    color: #6090b0;
    border-color: #2a4a6a;
}

/* ── Inputs ───────────────────────────────────────────── */
QLineEdit {
    background-color: #0e1828;
    border: 1px solid #1e3a5c;
    border-radius: 4px;
    padding: 5px 8px;
    color: #dde3ee;
    selection-background-color: #1565c0;
}
QLineEdit:focus {
    border-color: #4FC3F7;
}

QComboBox {
    background-color: #0e1828;
    border: 1px solid #1e3a5c;
    border-radius: 4px;
    padding: 4px 8px;
    color: #dde3ee;
    min-width: 100px;
}
QComboBox:hover {
    border-color: #4FC3F7;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
    background-color: #162033;
    border-left: 1px solid #1e3a5c;
    border-radius: 0 4px 4px 0;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    border: 2px solid #4FC3F7;
    border-top: none;
    border-left: none;
    transform: rotate(45deg);
    margin: -4px;
}
QComboBox QAbstractItemView {
    background-color: #0e1828;
    color: #dde3ee;
    selection-background-color: #1565c0;
    border: 1px solid #2a4a6a;
    outline: none;
}

/* ── Sliders ──────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 6px;
    background: #1a2a3a;
    border-radius: 3px;
    border: 1px solid #1e3a5c;
}
QSlider::handle:horizontal {
    background: #4FC3F7;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    border: 2px solid #0e1828;
}
QSlider::handle:horizontal:hover {
    background: #81d4fa;
    border-color: #4FC3F7;
}
QSlider::handle:horizontal:pressed {
    background: #0288d1;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1565c0, stop:1 #4FC3F7);
    border-radius: 3px;
}
QSlider::add-page:horizontal {
    background: #1a2a3a;
    border-radius: 3px;
}

/* ── SpinBox ──────────────────────────────────────────── */
QSpinBox {
    background-color: #0e1828;
    border: 1px solid #1e3a5c;
    border-radius: 4px;
    padding: 4px 6px;
    color: #dde3ee;
}
QSpinBox:hover { border-color: #4FC3F7; }
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #162033;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #1e3a5c;
}

/* ── Labels ───────────────────────────────────────────── */
QLabel { color: #dde3ee; }
QFormLayout QLabel { color: #7090b0; font-size: 12px; }

/* ── Scroll Bars ──────────────────────────────────────── */
QScrollBar:vertical {
    background: #0e1828;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #1e3a5c;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #4FC3F7; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #0e1828;
    height: 10px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: #1e3a5c;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #4FC3F7; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Scroll Area ──────────────────────────────────────── */
QScrollArea { border: none; background: transparent; }

/* ── Menu (right-click tab context) ──────────────────── */
QMenu {
    background-color: #0e1828;
    border: 1px solid #2a4a6a;
    color: #dde3ee;
    padding: 4px;
    border-radius: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: #1565c0;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #333355;
}
